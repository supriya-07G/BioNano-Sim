# Base URL for the COSMORA API.
# Leave empty to use the Vite dev proxy (recommended for local development):
# requests go to the same origin and Vite forwards /api to the backend.
VITE_API_BASE_URL=

# Where the dev proxy forwards /api. Change if the backend is not on port 8000.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Polling interval for active simulation jobs, in milliseconds (500-10000).
VITE_JOB_POLL_INTERVAL_MS=1200
