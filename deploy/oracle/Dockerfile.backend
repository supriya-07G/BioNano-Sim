# syntax=docker/dockerfile:1
#
# Backend-only image for a decoupled deployment: the frontend is served by
# Vercel, this serves the API.
#
# Separate from the repo-root Dockerfile on purpose. That one bundles the Vite
# build into the same image for a single-origin host; building it on a 1-OCPU
# Always Free VM means running a Node toolchain on hardware that has better
# things to do. This skips the frontend stage entirely.
#
# Architecture-neutral: OpenMM publishes manylinux_2_34 wheels for both
# x86_64 and aarch64, so this builds unchanged on Ampere A1 and on x86.

FROM python:3.11-slim

# OpenMM's wheel links against libgomp, which slim does not ship. Nothing is
# compiled here -- every dependency resolves to a prebuilt wheel -- so there is
# no need for build-essential, and adding it would cost ~300 MB.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv

# Runtime dependencies only. requirements-dev.txt pulls pytest, ruff and httpx,
# which have no business in a deployed image.
COPY backend/requirements.txt backend/requirements.txt
RUN python -m pip install --upgrade pip \
    && pip install -r backend/requirements.txt

# config.py derives every path from the repo root (backend/app -> backend ->
# /srv), so data/ and models/ must sit beside backend/ exactly as in the repo.
COPY backend/ backend/
COPY data/ data/
COPY models/ models/
COPY scripts/ scripts/

# Written on every job. Kept on a volume in compose so results survive a
# container restart.
ENV BIONANO_RUNTIME_DIR=/srv/runtime
RUN mkdir -p /srv/runtime && chown -R app:app /srv

# One OCPU is not four. A single concurrent job with a bounded step count
# keeps a demo responsive instead of letting one request monopolise the box.
ENV OPENMM_CPU_THREADS=2 \
    BIONANO_MAX_CONCURRENT_JOBS=1 \
    BIONANO_MAX_PRODUCTION_STEPS=20000 \
    BIONANO_JOB_WALL_CLOCK_LIMIT_S=600

USER app
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/api/v1/health || exit 1

# --app-dir backend is required, not stylistic. Every internal import is
# `from app.…`, and there is no backend/__init__.py, so `backend.app.main:app`
# fails with ModuleNotFoundError: No module named 'app'.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--app-dir", "backend"]
