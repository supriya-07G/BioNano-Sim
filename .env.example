# ---------------------------------------------------------------------------
# BioNano-Sim — root environment template
#
# For local development, use backend/.env and frontend/.env instead; each has
# its own .env.example.
# ---------------------------------------------------------------------------

# --- Backend (prefix BIONANO_) --------------------------------------------
BIONANO_LOG_LEVEL=INFO

# Comma-separated frontend origins allowed by CORS. Local dev only.
BIONANO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits
BIONANO_MAX_UPLOAD_BYTES=8388608
BIONANO_MAX_UPLOAD_ATOMS=100000
BIONANO_MAX_UPLOAD_RESIDUES=2000

# Simulation safety limits. max_concurrent_jobs above 1 needs a real queue,
# not just a bigger thread pool — see docs/architecture.md.
BIONANO_MAX_CONCURRENT_JOBS=1
BIONANO_MAX_PRODUCTION_STEPS=50000
BIONANO_MAX_MINIMISATION_STEPS=5000
BIONANO_JOB_WALL_CLOCK_LIMIT_S=900

# --- Frontend -------------------------------------------------------------
# Empty means same-origin (the Vite dev proxy forwards /api to the backend).
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_JOB_POLL_INTERVAL_MS=1200
