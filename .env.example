# ---------------------------------------------------------------------------
# COSMORA — root environment template
#
# For local development, use backend/.env and frontend/.env instead; each has
# its own .env.example.
# ---------------------------------------------------------------------------

# --- Backend (prefix COSMORA_) --------------------------------------------
COSMORA_LOG_LEVEL=INFO

# Comma-separated frontend origins allowed by CORS. Local dev only.
COSMORA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits
COSMORA_MAX_UPLOAD_BYTES=8388608
COSMORA_MAX_UPLOAD_ATOMS=100000
COSMORA_MAX_UPLOAD_RESIDUES=2000

# Simulation safety limits. max_concurrent_jobs above 1 needs a real queue,
# not just a bigger thread pool — see docs/architecture.md.
COSMORA_MAX_CONCURRENT_JOBS=1
COSMORA_MAX_PRODUCTION_STEPS=50000
COSMORA_MAX_MINIMISATION_STEPS=5000
COSMORA_JOB_WALL_CLOCK_LIMIT_S=900

# --- Frontend -------------------------------------------------------------
# Empty means same-origin (the Vite dev proxy forwards /api to the backend).
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_JOB_POLL_INTERVAL_MS=1200
