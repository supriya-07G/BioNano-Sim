# ---------------------------------------------------------------------------
# COSMORA backend — copy to backend/.env to override defaults.
# All settings use the COSMORA_ prefix (see backend/app/config.py).
# ---------------------------------------------------------------------------

COSMORA_LOG_LEVEL=INFO

# Frontend dev origins allowed by CORS. Deliberately not "*": the API accepts
# uploads and serves file downloads.
COSMORA_CORS_ORIGINS=["http://localhost:5173" , "http://127.0.0.1:5173"]

# Upload validation limits
COSMORA_MAX_UPLOAD_BYTES=8388608
COSMORA_MAX_UPLOAD_ATOMS=100000
COSMORA_MAX_UPLOAD_RESIDUES=2000

# Simulation safety limits. Raising max_concurrent_jobs above 1 requires a real
# queue rather than a larger thread pool; OpenMM runs are CPU/GPU-bound and two
# concurrent jobs on one device are slower than two in sequence.
COSMORA_MAX_CONCURRENT_JOBS=1
COSMORA_MAX_PRODUCTION_STEPS=50000
COSMORA_MAX_MINIMISATION_STEPS=5000
COSMORA_JOB_WALL_CLOCK_LIMIT_S=900
